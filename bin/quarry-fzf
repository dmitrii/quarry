#!/usr/bin/env bash
# quarry-fzf — interactively find a session and resume it (launched by `quarry fzf`).
#
# Thin launcher: feeds `quarry ls --tsv` into fzf; the keybindings decide what
# happens to the chosen session. fzf provides the entire UI.
#   enter   pick it -> the wrapper resumes it (cd to its dir, claude --resume)
#   ctrl-x  remove it (quarry rm), then refresh the list
#   ctrl-y  copy its UUID to the clipboard
#   tab     widen the search scope: names -> prompts -> replies
# The preview pane is `quarry ls <uuid>` (the detail view).
#
# fzf prints the selection and exits; THIS script (whose stdin is the terminal)
# then execs claude. Doing the resume here rather than via fzf's `become` is what
# keeps the terminal attached — with `become`, the resumed session renders but
# never receives keyboard input.
set -euo pipefail

# Resolve through symlinks to find the sibling quarry entry point.
src="${BASH_SOURCE[0]}"
while [ -L "$src" ]; do
  d="$(cd -P "$(dirname "$src")" && pwd)"
  src="$(readlink "$src")"
  case "$src" in /*) ;; *) src="$d/$src" ;; esac
done
DIR="$(cd -P "$(dirname "$src")" && pwd)"
SELF="$DIR/$(basename "$src")"

# The quarry command: prefer $QUARRY (exported by `quarry fzf`), else the sibling
# file, else whatever is on PATH.
Q="${QUARRY:-}"
[ -n "$Q" ] || { Q="$DIR/quarry"; [ -x "$Q" ] || Q="quarry"; }

# Build the fzf header for a given active scope; the active scope is CAPS so the
# current search breadth is always visible.
scope_header() {
  local a b c
  case "$1" in
    prompts) a=names;  b=PROMPTS; c=replies ;;
    replies) a=names;  b=prompts; c=REPLIES ;;
    *)       a=NAMES;  b=prompts; c=replies ;;
  esac
  printf 'enter resume · ctrl-x delete · ctrl-y copy uuid · tab scope: %s→%s→%s' "$a" "$b" "$c"
}

# Internal helpers invoked by fzf (start/reload). State = current scope, in $2.
case "${1:-}" in
  --_produce)
    exec "$Q" ls --tsv --scope "$(cat "$2" 2>/dev/null || echo names)" ;;
  --_tab)  # advance scope (looping), persist it, and emit an fzf action string
           # that reloads the list and rewrites the header for the new scope
    case "$(cat "$2" 2>/dev/null || echo names)" in
      names)   n=prompts ;;
      prompts) n=replies ;;
      *)       n=names ;;
    esac
    printf '%s' "$n" > "$2"
    printf 'reload(%s --_produce %s)+change-header(%s)' "$SELF" "$2" "$(scope_header "$n")"
    exit 0 ;;
esac

command -v fzf >/dev/null || { echo "quarry fzf: fzf is not installed (brew install fzf)" >&2; exit 127; }

STATE="$(mktemp)"; printf 'names' > "$STATE"
trap 'rm -f "$STATE"' EXIT

# fzf renders on /dev/tty and prints the accepted line to stdout, which we
# capture. A non-zero exit (Esc / no match) just means "nothing picked".
line="$(
  FZF_DEFAULT_COMMAND="$SELF --_produce $STATE" fzf \
    --exact \
    --delimiter '\t' --with-nth '2..' \
    --prompt 'session> ' \
    --header "$(scope_header names)" \
    --preview "$Q ls --color always {1}" \
    --preview-window 'right,55%,border-left,wrap' \
    --bind "tab:transform($SELF --_tab $STATE)" \
    --bind "ctrl-x:execute($Q rm {1})+reload($SELF --_produce $STATE)" \
    --bind 'ctrl-y:execute-silent(printf %s {1} | pbcopy)'
)" || exit 0
[ -n "$line" ] || exit 0

uuid="${line%%$'\t'*}"
dir="$(printf '%s' "$line" | cut -f3)"

# Guard: never resume a session that's currently open in a live process.
if "$Q" ls --isopen "$uuid"; then
  echo "Not resuming: session $uuid is open in a live claude process. Quit that tab first." >&2
  exit 1
fi
if [ -z "$dir" ] || ! cd "$dir" 2>/dev/null; then
  echo "Not resuming: launch directory unavailable: ${dir:-?}" >&2
  exit 1
fi
exec claude --resume "$uuid"
